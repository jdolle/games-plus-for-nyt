{
  "manifest_version": 3,
  "name": "Games Plus for NYT",
  "version": "0.1.0",
  "description": "Unofficial dark mode and keyboard shortcuts for NYT Games. Not affiliated with or endorsed by The New York Times.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "Games Plus for NYT"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.nytimes.com/crosswords/game/*"
      ],
      "js": [
        "games/crossword/content.js"
      ],
      "css": [
        "styles/theme.css",
        "games/crossword/dark.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.nytimes.com/games/connections*"
      ],
      "js": [
        "games/connections/content.js"
      ],
      "css": [
        "styles/theme.css",
        "games/connections/dark.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.nytimes.com/puzzles/spelling-bee*"
      ],
      "js": [
        "games/spelling-bee/content.js"
      ],
      "css": [
        "styles/theme.css",
        "games/spelling-bee/dark.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.nytimes.com/games/wordle/*"
      ],
      "js": [
        "games/wordle/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.nytimes.com/crosswords",
        "https://www.nytimes.com/crosswords/",
        "https://www.nytimes.com/crosswords?*",
        "https://www.nytimes.com/crosswords/?*"
      ],
      "js": [
        "pages/crosswords-hub/content.js"
      ],
      "css": [
        "styles/theme.css",
        "pages/crosswords-hub/dark.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.nytimes.com/crosswords/archive*"
      ],
      "js": [
        "pages/crosswords-archive/content.js"
      ],
      "css": [
        "styles/theme.css",
        "pages/crosswords-archive/dark.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.nytimes.com/subscription/games-offer*"
      ],
      "js": [
        "pages/subscription-offer/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
