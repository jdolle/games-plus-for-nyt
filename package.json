{
  "name": "games-plus-for-nyt",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial dark mode and keyboard shortcuts for NYT Games. Not affiliated with or endorsed by The New York Times.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node build.mjs --watch",
    "build": "node build.mjs",
    "test": "vitest run",
